{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv":["CLOUDFLARE_ACCOUNT_ID","CLOUDFLARE_D1_TOKEN","CLOUDFLARE_DATABASE_ID"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
